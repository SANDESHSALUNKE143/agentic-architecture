FROM node:22-alpine AS build

WORKDIR /src
COPY ui/packages/controls/package.json ui/packages/controls/package-lock.json ui/packages/controls/
WORKDIR /src/ui/packages/controls
RUN npm ci
WORKDIR /src
COPY ui/admin-dashboard/package.json ui/admin-dashboard/package-lock.json ui/admin-dashboard/
WORKDIR /src/ui/admin-dashboard
RUN npm ci
COPY ui/admin-dashboard /src/ui/admin-dashboard
COPY ui/packages/controls /src/ui/packages/controls
RUN npm run build

FROM nginx:1.27-alpine

COPY infrastructure/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/ui/admin-dashboard/dist /usr/share/nginx/html

EXPOSE 80

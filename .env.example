# Local API. Defaults run the mock. Do not commit a real .env.
PLATFORM_ENV=development
PLATFORM_DEV_TOKEN=local-dev-token-not-for-production
PLATFORM_LLM_MODE=mock
PLATFORM_PORT=8090
PLATFORM_TIMEOUT_SECONDS=8
# Live model. Leave unset to stay on the mock.
# MODEL_API_KEY=replace-locally
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4.1-mini
# Optional ports. Leave unset to keep SQL, web, retrieval, n8n, and observability local.
# SQL_CONNECTION=
# WEB_ALLOWLIST=example.test
# QDRANT_URL=
# NEO4J_URL=
# N8N_BASE_URL=
# N8N_TOKEN=replace-locally
# GRAFANA_URL=
# GRAFANA_PASSWORD=replace-locally
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OBSERVABILITY_LOG_URL=
# Embedding and vector backends, including AWS. Leave unset to stay on the local index.
# EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=
# QDRANT_API_KEY=replace-locally
# AWS_REGION=
# AWS_VECTOR_ENDPOINT=
# AWS_VECTOR_INDEX=
# AWS_EMBEDDING_MODEL=
# AWS_BEDROCK_MODEL=
# AWS_SECRET_ACCESS_KEY=replace-locally
# NEO4J_PASSWORD=replace-locally

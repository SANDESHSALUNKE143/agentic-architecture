# Only needed for optional Compose data services. Replace locally; never commit .env.
POSTGRES_PASSWORD=replace-with-random-local-password
QDRANT_API_KEY=replace-with-random-local-key
# Provider adapter reads this variable only when explicitly constructed.
MODEL_API_KEY=replace-locally

# Agentic platform local API. Defaults run the mock demo.
# PLATFORM_ENV=production rejects the default token below.
PLATFORM_ENV=development
PLATFORM_DEV_TOKEN=local-dev-token-not-for-production
PLATFORM_LLM_MODE=mock
PLATFORM_PORT=8090
# Optional. Leave unset to keep retrieval and n8n local.
# QDRANT_URL=
# N8N_BASE_URL=
# N8N_TOKEN=replace-locally

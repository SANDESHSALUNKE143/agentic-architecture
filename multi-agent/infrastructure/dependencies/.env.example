# Lab defaults for infrastructure/dependencies/docker-compose.yml.
# Copy to infrastructure/dependencies/.env before you change a password.
# These values are for a private lab server. They are not a production secret store.

LAB_PASSWORD=lab-password

PLATFORM_ENV=development
PLATFORM_DEV_TOKEN=local-dev-token-not-for-production
PLATFORM_LLM_MODE=mock
CONSOLE_PORT=5173

GRAFANA_ADMIN_USER=admin
GRAFANA_URL=http://grafana:3000
GRAFANA_PASSWORD=lab-password
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OBSERVABILITY_LOG_URL=http://loki:3100
N8N_BASE_URL=http://n8n:5678
N8N_TOKEN=lab-password
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=lab-password
NEO4J_URL=bolt://neo4j:7687
NEO4J_PASSWORD=lab-password
SQL_CONNECTION=postgresql://agentic:lab-password@sql:5432/agentic
LANGFUSE_PUBLIC_URL=http://localhost:3003
LANGFUSE_INIT_USER_EMAIL=lab@example.test
LANGFUSE_INIT_USER_NAME=Lab
N8N_OWNER_EMAIL=lab@example.test
MLFLOW_ADMIN_USER=admin

# Langfuse refuses to start without these. They are lab values, not production keys.
LANGFUSE_NEXTAUTH_SECRET=lab-nextauth-secret
LANGFUSE_SALT=lab-salt
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
N8N_ENCRYPTION_KEY=lab-n8n-encryption-key-not-for-production

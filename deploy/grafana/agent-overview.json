{
  "title": "Agent overview (prototype)",
  "uid": "agentic-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / second",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agent_requests_total[5m])) by (agent_id)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error fraction",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agent_requests_total{status=\"error\"}[5m])) by (agent_id) / clamp_min(sum(rate(agent_requests_total[5m])) by (agent_id), 0.001)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 duration (ms)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(agent_duration_ms_bucket[5m])) by (le, agent_id))"
        }
      ]
    }
  ]
}

FROM node:22-alpine AS build

WORKDIR /src
COPY packages/controls/package.json packages/controls/package-lock.json packages/controls/
WORKDIR /src/packages/controls
RUN npm ci
WORKDIR /src
COPY apps/admin-dashboard/package.json apps/admin-dashboard/package-lock.json apps/admin-dashboard/
WORKDIR /src/apps/admin-dashboard
RUN npm ci
COPY apps/admin-dashboard /src/apps/admin-dashboard
COPY packages/controls /src/packages/controls
RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/admin-dashboard/dist /usr/share/nginx/html

EXPOSE 80

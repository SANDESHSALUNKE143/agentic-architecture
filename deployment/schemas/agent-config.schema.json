{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implemented local configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "tenant_id",
    "llm_adapter",
    "token_budget",
    "max_output_tokens"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "llm_adapter": {
      "const": "echo"
    },
    "token_budget": {
      "type": "integer",
      "minimum": 1
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    }
  }
}

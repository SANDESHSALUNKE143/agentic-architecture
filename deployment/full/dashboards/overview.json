{
  "uid": "agentic-overview",
  "title": "Agentic platform - local operator",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Events by agent and type",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (agent_id,event) (rate(agentic_events_total[1m]))",
          "legendFormat": "{{agent_id}} {{event}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Content-free platform events",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=~\"agentic-platform|agentn-assistant\"}"
        }
      ]
    }
  ]
}

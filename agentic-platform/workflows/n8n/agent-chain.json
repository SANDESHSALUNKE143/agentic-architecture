{
  "name": "agent-chain",
  "nodes": [
    {
      "name": "Agent API",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8090/webhook/agent-chain",
        "jsonBody": "={{ JSON.stringify({ task: $json.body.task, agents: $json.body.agents }) }}"
      }
    }
  ]
}
